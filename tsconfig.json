{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@astrojs/ts-content-mapper"
      }
    ]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "public/ruffle/",
    "public/flash/",
    "public/games/run3/",
    "dist/",
    ".astro/",
    "node_modules/"
  ]
}
