---
import "../styles/styles.css";
import Gametile from "../components/gametile.astro";
import { gamesMap, defaultGames, MORE_COUNT } from "../data/game-seo";
import { SITE } from "../data/site";

interface Props {
  slug?: string;
  pageTitle?: string;
  isHome?: boolean;
  noIndex?: boolean;
}

const { slug, pageTitle, isHome, noIndex = false } = Astro.props;
const siteUrl = (Astro.site?.toString() ?? SITE).replace(/\/$/, "");

// SEO data — `slug` is the page slug; display name comes from the registry
const seo = slug ? gamesMap[slug] : undefined;
const Game = seo?.title;
const isFlash = seo?.isFlash ?? false;
// ponytail: static date keeps dateModified stable across builds; bump with the catalog
const dateModified = "2026-10-22";
const jsonLD = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");

// Title
const gameTitle = Game
  ? `Play ${Game} Unblocked on Chromebook - No Flash Required (2026)`
  : pageTitle || "Superfun Games - Unblocked Games for School Chromebook";

// Description
const homeDescription = "Play free unblocked games on your school Chromebook - Happy Wheels, Plants vs Zombies, Run 3 and more. No downloads, works in your browser.";

const gameDescription = isHome ? homeDescription : seo?.description || pageTitle || homeDescription;

// Image & other SEO fields — ponytail: webp covers beat SVG for og:image validators
const gameImage = seo?.image || "/images/happy-wheels-cover.webp";

const gameGenre = seo?.genre || "Game";
const gameYear = seo?.year || "";

// URL
const canonicalPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const pageUrl = `${siteUrl}${canonicalPath === "/" ? "" : canonicalPath}`;
// absolute, because games/[slug].astro sets <base> for vendored bundles;
// the 404 is served for any path, so it must stay an in-page jump
const skipHref = noIndex ? "#main-content" : `${canonicalPath}#main-content`;

// More Games cross-linking — same genre first, then fill from popular
const validGames = defaultGames.filter((s) => gamesMap[s]);
const moreGames = (() => {
  if (!slug || !seo) return validGames.slice(0, MORE_COUNT);
  const rest = validGames.filter((s) => s !== slug);
  return [
    ...rest.filter((s) => gamesMap[s].genre === seo.genre),
    ...rest.filter((s) => gamesMap[s].genre !== seo.genre),
  ].slice(0, MORE_COUNT);
})();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{gameTitle}</title>
    <meta name="description" content={gameDescription} />
    <meta name="robots" content={noIndex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" id="theme-color" content="#ffffff" />
    <link rel="canonical" href={pageUrl} />

    {
      isHome && (
        <meta name="google-site-verification" content="NBlOMVSv6plhaf7kQsHx4aXHHlFlw1q8N0s44BOlVyk" />
      )
    }

    {
      isFlash && (
        <link rel="preload" href="/ruffle/ruffle.js" as="script" fetchpriority="high" />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={gameTitle} />
    <meta property="og:description" content={gameDescription} />
    <meta property="og:image" content={`${siteUrl}${gameImage}`} />
    <meta property="og:image:width" content="300" />
    <meta property="og:image:height" content="200" />
    <meta property="og:image:alt" content={Game ? `${Game} - play unblocked online` : "Superfun Games - unblocked games"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Superfun Games" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={gameTitle} />
    <meta name="twitter:description" content={gameDescription} />
    <meta name="twitter:image" content={`${siteUrl}${gameImage}`} />
    <meta name="twitter:image:alt" content={Game ? `${Game} - play unblocked online` : "Superfun Games - unblocked games"} />

    {
      Game && !isHome ? (
        <>
          <!-- JSON-LD BreadcrumbList -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "BreadcrumbList",
              itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
                { "@type": "ListItem", position: 2, name: Game, item: pageUrl },
              ],
            })}
          />
          <!-- JSON-LD VideoGame -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "VideoGame",
              name: Game,
              description: gameDescription,
              image: `${siteUrl}${gameImage}`,
              url: pageUrl,
              genre: gameGenre,
              gamePlatform: "Web Browser",
              operatingSystem: "All (including Chrome OS / Chromebook)",
              browserRequirements: "Works in all modern browsers including Chrome on Chromebook",
              author: { "@type": "Organization", name: "Superfun Games" },
              offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
                availability: "https://schema.org/InStock",
              },
              applicationCategory: "GameApplication",
              dateModified: dateModified,
              ...(gameYear ? { datePublished: gameYear } : {}),
              ...(isFlash ? { requirements: "No Flash plugin needed - runs via Ruffle emulator" } : {}),
            })}
          />
          {seo?.guide && (
            <script
              is:inline
              type="application/ld+json"
              set:html={jsonLD({
                "@context": "https://schema.org",
                "@type": "FAQPage",
                mainEntity: [
                  {
                    "@type": "Question",
                    name: `How do you play ${Game}?`,
                    acceptedAnswer: { "@type": "Answer", text: seo.guide },
                  },
                  {
                    "@type": "Question",
                    name: `Does ${Game} work on a school Chromebook?`,
                    acceptedAnswer: {
                      "@type": "Answer",
                      text: `Yes. ${Game} runs directly in your browser with no download${isFlash ? " via the Ruffle emulator" : ""} and works on school Chromebooks.`,
                    },
                  },
                ],
              })}
            />
          )}
        </>
      ) : null
    }

    {
      isHome ? (
        <>
          <!-- JSON-LD WebSite -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "WebSite",
              name: "Superfun Games",
              url: siteUrl,
              description: homeDescription,
            })}
          />
          <!-- JSON-LD CollectionPage -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "CollectionPage",
              name: "Unblocked Games Collection",
              description:
                "A curated collection of classic Flash games and browser games that work without Flash Player. All games run directly in your browser using modern emulation.",
              url: siteUrl,
              about: { "@type": "Thing", name: "Classic Browser Games" },
            })}
          />
          <!-- JSON-LD Organization -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "Organization",
              name: "Superfun Games",
              url: siteUrl,
              logo: `${siteUrl}/images/games-logo-light.svg`,
              description: homeDescription,
              foundingDate: "2024",
              sameAs: ["https://github.com/noahgsolomon/unblocked-games"],
            })}
          />
        </>
      ) : null
    }

    <link rel="preconnect" href="https://rybbit.theoneand33.dev" />
    <script is:inline defer fetchpriority="low" src="https://rybbit.theoneand33.dev/api/script.js" data-site-id="62ae034debad"></script>
    <script is:inline defer fetchpriority="low" src="/_vercel/insights/script.js"></script>
    <script is:inline defer fetchpriority="low" src="/_vercel/speed-insights/script.js"></script>
    {/* non-blocking: 41KB blocking stylesheet costs ~600ms FCP on Slow 4G */}
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" media="print" onload="this.media='all'" />
    <script src="/pagefind/pagefind-component-ui.js" type="module" fetchpriority="low" is:inline></script>
    <script is:inline>
      // ponytail: light is default, dark only on explicit choice
      try {
        var dark = localStorage.getItem("theme") === "dark";
        if (dark) document.documentElement.classList.add("dark");
        var m = document.getElementById("theme-color");
        if (m) m.setAttribute("content", dark ? "#0a0a0a" : "#ffffff");
      } catch {}
    </script>
  </head>
  <body class="bg-white text-gray-900 dark:bg-neutral-950 dark:text-neutral-100">
    <a href={skipHref} class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:text-black dark:focus:bg-neutral-900 dark:focus:text-white">Skip to content</a>
    <nav aria-label="Primary" class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-4">
      <a href="/" class="shrink-0">
        <img
          src="/images/games-logo-light.svg"
          alt="Superfun Games - Unblocked Games Home"
          width="300"
          height="90"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block h-20 w-auto dark:hidden"
        />
        <img
          src="/images/games-logo-dark.svg"
          alt="Superfun Games - Unblocked Games Home"
          width="300"
          height="90"
          loading="eager"
          decoding="async"
          class="hidden h-20 w-auto dark:block"
        />
      </a>
      <div class="flex items-center gap-4 text-sm">
        <a href="/" class="py-2 text-gray-800 transition-colors hover:text-black dark:text-neutral-200 dark:hover:text-white">Home</a>
        <a href="/dmca" class="py-2 text-gray-800 transition-colors hover:text-black dark:text-neutral-200 dark:hover:text-white">DMCA</a>
        <button
          type="button"
          id="theme-toggle"
          aria-label="Switch to dark theme"
          aria-pressed="false"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-neutral-100 transition-colors hover:bg-neutral-200 dark:bg-neutral-900 dark:hover:bg-neutral-800"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700 dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-200 hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </button>
        <button
          type="button"
          id="random-game"
          aria-label="Play a random game"
          title="Play a random game"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-neutral-100 transition-colors hover:bg-neutral-200 dark:bg-neutral-900 dark:hover:bg-neutral-800"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700 dark:text-neutral-200"><path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.8-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/></svg>
        </button>
        <search aria-label="Site search">
          <pagefind-searchbox></pagefind-searchbox>
        </search>
      </div>
    </nav>

    <main
      id="main-content"
      tabindex="-1"
      data-pagefind-body={noIndex ? undefined : ""}
    >
      {Game && !isHome && (
        <div class="mx-auto max-w-[1440px] px-5 pt-6">
          <h1 class="text-2xl font-bold tracking-tight text-balance sm:text-3xl">
            Play {Game} Unblocked on Chromebook
          </h1>
          <div class="mt-3 max-w-3xl">
            <p class="text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
              {gameDescription}
            </p>
            <!-- genre is visible text so site search can find games by type -->
            <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-600 dark:text-neutral-400">
              <span class="rounded-md bg-neutral-100 px-2 py-0.5 font-medium text-gray-800 dark:bg-neutral-900 dark:text-neutral-200">{gameGenre}</span>
              {gameYear && <span>{gameYear}</span>}
              <span class="text-gray-400 dark:text-neutral-600" aria-hidden="true">·</span>
              <span class="text-gray-500 dark:text-neutral-500">
                {isFlash
                  ? "No Flash plugin required — works on school Chromebooks via Ruffle emulator"
                  : "Works on school Chromebooks — no downloads needed"}
              </span>
            </p>
          </div>
        </div>
      )}
      <slot />
    </main>

    {Game && !isHome && (
      <div class="mx-auto max-w-[1440px] px-5 pt-8">
        <!-- More Games cross-linking (dynamically generated) -->
        <nav aria-label="More unblocked games" class="rounded-2xl bg-neutral-50 px-4 py-5 dark:bg-neutral-900/60">
          <h2 class="mb-4 text-xl font-semibold tracking-tight text-gray-900 dark:text-neutral-100">More Unblocked Games</h2>
          <ul class="grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-4 p-0">
            {moreGames.map((s) => (
              <li>
                <Gametile Game={gamesMap[s].title} Path={`/games/${s}`} Image={gamesMap[s].image} />
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )}

    <footer class="mx-auto max-w-[1440px] px-5 py-10">
      <p class="text-sm text-gray-600 dark:text-neutral-400">
        All games sourced from <a
          class="text-blue-700 underline-offset-2 hover:underline dark:text-blue-400"
          href="https://archive.org">Internet Archive</a
        > · <a class="text-blue-700 underline-offset-2 hover:underline dark:text-blue-400" href="/about">About</a>
      </p>
    </footer>
    <script is:inline>
      // ponytail: icons swap via dark: classes, JS only flips the class
      (function () {
        function sync() {
          var dark = document.documentElement.classList.contains("dark");
          var m = document.getElementById("theme-color");
          if (m) m.setAttribute("content", dark ? "#0a0a0a" : "#ffffff");
          var b = document.getElementById("theme-toggle");
          if (b) {
            b.setAttribute("aria-pressed", dark ? "true" : "false");
            b.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
          }
        }
        document.addEventListener("click", function (e) {
          var b = e.target && e.target.closest ? e.target.closest("#theme-toggle") : null;
          if (!b) return;
          var dark = document.documentElement.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
          sync();
        });
        sync();
      })();
    </script>
    <script is:inline define:vars={{ slugs: defaultGames }}>
      // ponytail: static build, so pick random client-side
      document.addEventListener("click", function (e) {
        var b = e.target && e.target.closest ? e.target.closest("#random-game") : null;
        if (!b || !slugs.length) return;
        var pick = slugs[Math.floor(Math.random() * slugs.length)];
        var here = window.location.pathname;
        for (var i = 0; i < 3 && here === "/games/" + pick; i++) {
          pick = slugs[Math.floor(Math.random() * slugs.length)];
        }
        window.location.href = "/games/" + pick;
      });
    </script>
    {
      seo && slug && (
        <script define:vars={{ slug, title: seo.title, image: seo.image }} is:inline>
          try {
            var k = "recently-played";
            var r = [];
            try {
              r = JSON.parse(localStorage.getItem(k)) || [];
            } catch {}
            if (!Array.isArray(r)) r = [];
            r = [{ s: slug, t: title, i: image }]
              .concat(r.filter(function (x) { return x && x.s !== slug; }))
              .slice(0, 10);
            localStorage.setItem(k, JSON.stringify(r));
          } catch {}
        </script>
      )
    }
  </body>
</html>
