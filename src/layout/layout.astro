---
import "../styles/styles.css";
import Gametile from "../components/gametile.astro";
import { gamesMap, defaultGames, MORE_GAMES_COUNT } from "../data/game-seo";

interface Props {
  slug?: string;
  pageTitle?: string;
  isHome?: boolean;
}

const { slug, pageTitle, isHome } = Astro.props;
const siteUrl = "https://unblocked-games.vercel.app";

// SEO data — `slug` is the page slug; display name comes from the registry
const seo = slug ? gamesMap[slug] : undefined;
const Game = seo?.title;
const isFlash = seo?.isFlash ?? false;
// ponytail: static date keeps dateModified stable across builds
const dateModified = "2026-09-07";
const jsonLD = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");

// Title
const gameTitle = Game
  ? `Play ${Game} Unblocked on Chromebook - No Flash Required (2026)`
  : pageTitle || "Superfun Games - Unblocked Games for School Chromebook";

// Description
const homeDescription = "Play free unblocked games on your school Chromebook - Happy Wheels, Plants vs Zombies, Run 3 and more. No downloads, works in your browser.";

const gameDescription = isHome
  ? homeDescription
  : seo?.description ||
    (Game
      ? `Play ${Game} unblocked on your school Chromebook. No Flash plugin or download needed - runs directly in your browser. Fully working 2026 version of this classic game.`
      : pageTitle || homeDescription);

// Image & other SEO fields — ponytail: webp covers beat SVG for og:image validators
const gameImage = isHome
  ? "/images/happywheelscover.webp"
  : seo?.image || "/images/happywheelscover.webp";

const gameGenre = seo?.genre || "Game";
const gameYear = seo?.year || "";

// URL
const pageUrl = slug ? `${siteUrl}/games/${slug}` : siteUrl;

// More Games cross-linking — same genre first, then fill from popular
// ponytail: two passes over defaultGames, no new data structures
const moreGames = (() => {
  if (!slug || !seo) return defaultGames.slice(0, MORE_GAMES_COUNT);
  const rest = defaultGames.filter((s) => s !== slug);
  return [
    ...rest.filter((s) => gamesMap[s].genre === seo.genre),
    ...rest.filter((s) => gamesMap[s].genre !== seo.genre),
  ].slice(0, MORE_GAMES_COUNT);
})();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{gameTitle}</title>
    <meta name="description" content={gameDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" id="theme-color" content="#ffffff" />
    <link rel="canonical" href={pageUrl} />

    {
      isHome && (
        <meta name="google-site-verification" content="NBlOMVSv6plhaf7kQsHx4aXHHlFlw1q8N0s44BOlVyk" />
      )
    }

    {
      isFlash && (
        <link rel="preload" href="/ruffle/ruffle.js" as="script" crossorigin="anonymous" />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={gameTitle} />
    <meta property="og:description" content={gameDescription} />
    <meta property="og:image" content={`${siteUrl}${gameImage}`} />
    <meta property="og:image:width" content="300" />
    <meta property="og:image:height" content="200" />
    <meta property="og:image:alt" content={Game ? `${Game} - play unblocked online` : "Superfun Games - unblocked games"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Superfun Games" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={gameTitle} />
    <meta name="twitter:description" content={gameDescription} />
    <meta name="twitter:image" content={`${siteUrl}${gameImage}`} />
    <meta name="twitter:image:alt" content={Game ? `${Game} - play unblocked online` : "Superfun Games - unblocked games"} />

    {
      Game && !isHome ? (
        <>
          <!-- JSON-LD BreadcrumbList -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "BreadcrumbList",
              itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
                { "@type": "ListItem", position: 2, name: Game, item: pageUrl },
              ],
            })}
          />
          <!-- JSON-LD VideoGame -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "VideoGame",
              name: Game,
              description: gameDescription,
              image: `${siteUrl}${gameImage}`,
              url: pageUrl,
              genre: gameGenre,
              gamePlatform: "Web Browser",
              operatingSystem: "All (including Chrome OS / Chromebook)",
              browserRequirements: "Works in all modern browsers including Chrome on Chromebook",
              author: { "@type": "Organization", name: "Superfun Games" },
              offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
                availability: "https://schema.org/InStock",
              },
              applicationCategory: "GameApplication",
              dateModified: dateModified,
              ...(gameYear ? { datePublished: gameYear } : {}),
              ...(isFlash ? { requirements: "No Flash plugin needed - runs via Ruffle emulator" } : {}),
            })}
          />
          {seo?.guide && (
            <script
              is:inline
              type="application/ld+json"
              set:html={jsonLD({
                "@context": "https://schema.org",
                "@type": "FAQPage",
                mainEntity: [
                  {
                    "@type": "Question",
                    name: `How do you play ${Game}?`,
                    acceptedAnswer: { "@type": "Answer", text: seo.guide },
                  },
                  {
                    "@type": "Question",
                    name: `Does ${Game} work on a school Chromebook?`,
                    acceptedAnswer: {
                      "@type": "Answer",
                      text: `Yes. ${Game} runs directly in your browser with no download${isFlash ? " via the Ruffle emulator" : ""} and works on school Chromebooks.`,
                    },
                  },
                ],
              })}
            />
          )}
        </>
      ) : null
    }

    {
      isHome ? (
        <>
          <!-- JSON-LD WebSite -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "WebSite",
              name: "Superfun Games",
              url: siteUrl,
              description: homeDescription,
            })}
          />
          <!-- JSON-LD CollectionPage -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "CollectionPage",
              name: "Unblocked Games Collection",
              description:
                "A curated collection of classic Flash games and browser games that work without Flash Player. All games run directly in your browser using modern emulation.",
              url: siteUrl,
              about: { "@type": "Thing", name: "Classic Browser Games" },
            })}
          />
          <!-- JSON-LD Organization -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "Organization",
              name: "Superfun Games",
              url: siteUrl,
              logo: `${siteUrl}/images/games_logo_light.svg`,
              description: homeDescription,
              foundingDate: "2024",
              sameAs: ["https://github.com/noahgsolomon/unblocked-games"],
            })}
          />
        </>
      ) : null
    }

    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" type="module" is:inline></script>
    <script is:inline>
      // ponytail: class toggle beats media query — persists user choice
      try {
        var t = localStorage.getItem("theme");
        var dark = t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
        var m = document.getElementById("theme-color");
        if (m) m.setAttribute("content", dark ? "#0a0a0a" : "#ffffff");
      } catch {}
    </script>
  </head>
  <body class="bg-white text-gray-900 dark:bg-neutral-950 dark:text-neutral-100">
    <nav class="flex items-center justify-between">
      <a href="/">
        <img
          src="/images/games_logo_light.svg"
          alt="Superfun Games - Unblocked Games Home"
          width="300"
          class="m-5 block dark:hidden"
        />
        <img
          src="/images/games_logo_dark.svg"
          alt="Superfun Games - Unblocked Games Home"
          width="300"
          class="m-5 hidden dark:block"
        />
      </a>
      <div class="mr-5 flex gap-4 text-sm items-center">
        <a href="/" class="hover:text-black text-gray-800 dark:text-neutral-200 dark:hover:text-white transition-colors">Home</a>
        <a href="/dmca" class="hover:text-black text-gray-800 dark:text-neutral-200 dark:hover:text-white transition-colors">DMCA</a>
        <button
          type="button"
          id="theme-toggle"
          aria-label="Switch to dark theme"
          aria-pressed="false"
          class="rounded-lg border border-gray-300 bg-white px-2 py-1 dark:border-neutral-700 dark:bg-neutral-900 hover:bg-gray-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700 dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-200 hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </button>
        <pagefind-searchbox></pagefind-searchbox>
      </div>
    </nav>

    <main>
      {Game && !isHome && (
        <div class="mx-auto max-w-[1200px] px-6 pt-2">
          <h1 data-pagefind-body class="text-xl font-bold">
            Play {Game} Unblocked on Chromebook
          </h1>
          <div class="py-2">
            <p class="text-sm text-gray-500 dark:text-neutral-400 mb-1 line-clamp-3">
              {gameDescription}
            </p>
            <p class="text-xs text-gray-400 dark:text-neutral-500 font-medium">
              ✓ {isFlash
                ? "No Flash plugin required — works on school Chromebooks via Ruffle emulator"
                : "Works on school Chromebooks — no downloads needed"}
            </p>
          </div>
        </div>
      )}
      <slot />
    </main>

    {Game && !isHome && (
      <div class="mx-auto max-w-[1200px] px-6 pt-2">
        <!-- More Games cross-linking (dynamically generated) -->
        <nav aria-label="More unblocked games" class="border-t border-gray-200 dark:border-neutral-800 mt-4 py-4">
          <h2 class="text-sm font-semibold mb-2 text-gray-700 dark:text-neutral-300">More Unblocked Games</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-[10px]">
            {moreGames.map((s) => (
              <Gametile Game={gamesMap[s].title} Path={`/games/${s}`} Image={gamesMap[s].image} />
            ))}
          </div>
        </nav>
      </div>
    )}

    <footer>
      <p class="ml-6 mb-4 text-sm text-gray-600 dark:text-neutral-400">
        All games sourced from <a
          class="hover:underline underline-offset-2 text-blue-600 dark:text-blue-400"
          href="https://archive.org">Internet Archive</a
        > · <a class="hover:underline underline-offset-2 text-blue-600 dark:text-blue-400" href="/about">About</a>
      </p>
    </footer>
    <script is:inline>
      // ponytail: icons swap via dark: classes, JS only flips the class
      (function () {
        function sync() {
          var dark = document.documentElement.classList.contains("dark");
          var m = document.getElementById("theme-color");
          if (m) m.setAttribute("content", dark ? "#0a0a0a" : "#ffffff");
          var b = document.getElementById("theme-toggle");
          if (b) {
            b.setAttribute("aria-pressed", dark ? "true" : "false");
            b.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
          }
        }
        document.addEventListener("click", function (e) {
          var b = e.target && e.target.closest ? e.target.closest("#theme-toggle") : null;
          if (!b) return;
          var dark = document.documentElement.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
          sync();
        });
        sync();
      })();
    </script>
    {
      seo && slug && (
        <script define:vars={{ slug, title: seo.title, image: seo.image }} is:inline>
          try {
            var k = "recently-played";
            var r = [];
            try {
              r = JSON.parse(localStorage.getItem(k)) || [];
            } catch {}
            if (!Array.isArray(r)) r = [];
            r = [{ s: slug, t: title, i: image }]
              .concat(r.filter(function (x) { return x && x.s !== slug; }))
              .slice(0, 10);
            localStorage.setItem(k, JSON.stringify(r));
          } catch {}
        </script>
      )
    }
  </body>
</html>
