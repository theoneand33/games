---
interface Props {
  Game: string;
  Path: string;
  Image: string;
  eager?: boolean;
}
const { Game, Path, Image, eager = false } = Astro.props;
const altText = `${Game} unblocked - play online free`;
---

<a href={Path} class="m-5 inline-block max-w-full text-center no-underline">
  <img
    src={Image}
    alt={altText}
    width="300"
    height="200"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class="aspect-[3/2] h-auto w-full max-w-[300px] rounded-xl transition-transform duration-300 hover:scale-105 active:scale-95"
  />
  <p class="text-gray-800 dark:text-neutral-200 transition-colors hover:text-black dark:hover:text-white">{Game}</p>
</a>
