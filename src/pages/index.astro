---
import Layout from "../layout/layout.astro";
import Gametile from "../components/gametile.astro";
import { gamesMap, defaultGames, POPULAR_COUNT } from "../data/game-seo";

const pageTitle =
  "Superfun Games - Unblocked Games for School Chromebook | No Flash Required (2026)";

const validGames = defaultGames.filter((slug) => gamesMap[slug]);
const popularGames = validGames.slice(0, POPULAR_COUNT);
const link =
  "text-blue-700 dark:text-blue-400 underline-offset-2 hover:underline";
---

<Layout pageTitle={pageTitle} isHome={true}>
  <div class="mx-auto max-w-[1440px] px-5 pb-16">
    <header class="max-w-3xl pt-8 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Play Unblocked Games on Your School Chromebook - Working 2026
      </h1>
      <p class="mt-4 text-base leading-relaxed text-gray-600 dark:text-neutral-400">
        Play classic Flash games and browser games on your school Chromebook
        without needing any plugins or downloads. All games run directly in your
        Chrome browser via Ruffle emulation - no Flash Player required. Relive
        your favorite nostalgic games like <a href="/games/happy-wheels" class={link}
          >Happy Wheels</a
        >, <a href="/games/plants-vs-zombies" class={link}>Plants vs Zombies</a
        >, <a href="/games/strike-force-heroes" class={link}>Strike Force Heroes</a
        >, and more. Updated and working in 2026.
      </p>
      <p class="mt-3 text-sm text-gray-500 dark:text-neutral-500">
        Mirrors (your saves come with you): <a href="https://unblocked-games.vercel.app/" class={link} data-carry-progress
          >unblocked-games.vercel.app</a
        > · <a href="https://gamehub-games.vercel.app/" class={link} data-carry-progress
          >gamehub-games.vercel.app</a
        > · <a href="https://superfun-games.vercel.app/" class={link} data-carry-progress
          >superfun-games.vercel.app</a
        > · <a href="https://games.pine8013.workers.dev/" class={link} data-carry-progress
          >games.pine8013.workers.dev</a
        >
      </p>
      <script is:inline>
        // Saves (Ruffle SharedObjects, Run 3) live in per-origin localStorage, so mirror links carry them in the URL hash.
        // shortcut: a URL holds ~2MB in Chrome, move to a sync backend if saves outgrow that
        (function () {
          function gz(stream, fmt) {
            return new Response(stream.pipeThrough(fmt));
          }
          document.addEventListener("click", function (e) {
            var a = e.target && e.target.closest ? e.target.closest("a[data-carry-progress]") : null;
            if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (typeof CompressionStream === "undefined") return;
            e.preventDefault();
            var d = {};
            try {
              for (var i = 0; i < localStorage.length; i++) {
                var k = localStorage.key(i);
                d[k] = localStorage.getItem(k);
              }
            } catch {}
            gz(new Blob([JSON.stringify(d)]).stream(), new CompressionStream("gzip"))
              .arrayBuffer()
              .then(function (buf) {
                var b = new Uint8Array(buf);
                var s = "";
                for (var i = 0; i < b.length; i += 0x8000) s += String.fromCharCode.apply(null, b.subarray(i, i + 0x8000));
                location.href = a.href + "#progress=" + btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
              })
              .catch(function () {
                location.href = a.href;
              });
          });

          var m = location.hash.match(/^#progress=([\w-]+)$/);
          if (!m) return;
          history.replaceState(null, "", location.pathname + location.search);
          // only accept progress sent from a listed mirror, so other sites cannot craft save-overwriting links
          var from = "";
          try {
            from = new URL(document.referrer).origin;
          } catch {}
          var mirrors = Array.prototype.map.call(document.querySelectorAll("a[data-carry-progress]"), function (a) {
            return a.origin;
          });
          if (mirrors.indexOf(from) < 0 || typeof DecompressionStream === "undefined") return;
          try {
            var bin = atob(m[1].replace(/-/g, "+").replace(/_/g, "/"));
            var bytes = Uint8Array.from(bin, function (c) {
              return c.charCodeAt(0);
            });
          } catch {
            return alert("Could not read the progress from " + from + ".");
          }
          gz(new Blob([bytes]).stream(), new DecompressionStream("gzip"))
            .text()
            .then(function (t) {
              var d = JSON.parse(t);
              if (!d || typeof d !== "object" || Array.isArray(d)) throw 0;
              if (!confirm("Bring your game progress from " + from + "? Matching saves and settings here will be replaced.")) return;
              var old = {};
              try {
                for (var k in d)
                  if (typeof d[k] === "string") {
                    old[k] = localStorage.getItem(k);
                    localStorage.setItem(k, d[k]);
                  }
              } catch {
                // roll back so no game is left with half-imported saves
                for (var o in old) old[o] === null ? localStorage.removeItem(o) : localStorage.setItem(o, old[o]);
                return alert("Not enough storage to import your saves. Nothing was changed.");
              }
              location.reload();
            })
            .catch(function () {
              alert("Could not read the progress from " + from + ".");
            });
        })();
      </script>
    </header>

    <nav aria-label="Popular games" class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-neutral-100">Popular</h2>
      {
        popularGames.map((slug) => (
          <a
            href={"/games/" + slug}
            class="text-sm text-gray-600 underline-offset-2 transition-colors hover:text-black hover:underline dark:text-neutral-400 dark:hover:text-white"
          >
            {gamesMap[slug].title}
          </a>
        ))
      }
    </nav>

    <section id="recent" hidden class="mb-10">
      <h2 class="mb-4 text-xl font-semibold tracking-tight">Recently played</h2>
      <ul
        id="recent-row"
        class="grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-4 p-0"
      >
      </ul>
    </section>
    <script is:inline define:vars={{ valid: validGames }}>
      (function () {
        try {
          var r = JSON.parse(localStorage.getItem("recently-played") || "[]");
          if (!Array.isArray(r) || !r.length) return;
          var sec = document.getElementById("recent");
          var row = document.getElementById("recent-row");
          r.slice(0, 10).forEach(function (g) {
            if (!g || !g.s || !g.t || !g.i || valid.indexOf(g.s) < 0) return;
            var li = document.createElement("li");
            var a = document.createElement("a");
            a.href = "/games/" + g.s;
            a.className = "group flex h-full flex-col rounded-xl p-2 no-underline transition-colors hover:bg-neutral-100 dark:hover:bg-neutral-900";
            var frame = document.createElement("span");
            frame.className =
              "block overflow-hidden rounded-lg bg-neutral-100 dark:bg-neutral-900";
            var img = document.createElement("img");
            img.src = g.i;
            img.alt = g.t + " unblocked - play online free";
            img.width = 300;
            img.height = 200;
            img.loading = "lazy";
            img.decoding = "async";
            img.className =
              "aspect-[3/2] h-auto w-full transition-transform duration-300 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100";
            frame.appendChild(img);
            var p = document.createElement("p");
            p.className =
              "mt-2 px-1 text-sm font-medium text-gray-800 dark:text-neutral-200";
            p.textContent = g.t;
            a.appendChild(frame);
            a.appendChild(p);
            li.appendChild(a);
            row.appendChild(li);
          });
          if (row.children.length) sec.hidden = false;
        } catch {}
      })();
    </script>

    <h2 class="sr-only">All unblocked games</h2>
    <ul
      class="grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-4 p-0"
    >
      {
        validGames.map((slug, i) => {
          const seo = gamesMap[slug];
          return (
            <li>
              <Gametile
                Game={seo.title}
                Path={"/games/" + slug}
                Image={seo.image}
                eager={i === 0}
              />
            </li>
          );
        })
      }
    </ul>
  </div>
</Layout>
