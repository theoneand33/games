---
import Layout from "../../layout/layout.astro";
import Flash from "../../components/flash.astro";
import FullscreenButton from "../../components/fullscreen-button.astro";
import { gamesMap } from "../../data/game-seo";

export async function getStaticPaths() {
  return Object.keys(gamesMap).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const seo = slug ? gamesMap[slug] : undefined;
if (!seo) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout slug={slug}>
  {
    slug === "run-3" && (
      <Fragment slot="head">
        <base href="/games/run3/" />
      </Fragment>
    )
  }
  {
    seo.isFlash ? (
      <Flash gamePath={seo.gamePath} />
    ) : slug === "run-3" ? (
      <>
        <div id="run3-container">
          <div id="run3-wrapper" class="text-center h-[96vh] w-full">
            <div id="openfl-content" class="bg-black w-full h-full" />
          </div>
          <div class="flex justify-center pt-2">
            <FullscreenButton targetId="run3-container" />
          </div>
        </div>
        <script src="/games/run3/Run3.js" defer is:inline></script>
        <script data-astro-rerun is:inline>
          (function () {
            // ponytail: only lock scrolling over the game canvas, not the whole page
            window.addEventListener("touchmove", function (event) {
              var el = document.getElementById("openfl-content");
              if (el && el.contains(event.target)) event.preventDefault();
            }, { capture: false, passive: false });
            // ponytail: Run3.js is ~7MB, so never give up — show a status line after 15s
            // and keep polling slower, then drop it once the game embeds
            var attempts = 0;
            var ready = function () {
              var el = document.getElementById("openfl-content");
              if (!el) return;
              var status = el.querySelector(".flash-error");
              if (typeof lime !== "undefined" && lime.embed) {
                if (status) status.remove();
                try {
                  lime.embed("Run3", "openfl-content", 800, 600, { parameters: {} });
                } catch (e) {
                  console.error("Run3 embed failed:", e);
                }
              } else if (++attempts > 75) {
                if (!status) {
                  var div = document.createElement("div");
                  div.className = "flash-error";
                  div.textContent = "Still loading — this game is large. Give it a moment, or refresh if it stays stuck.";
                  el.appendChild(div);
                }
                setTimeout(ready, 2000);
              } else {
                setTimeout(ready, 200);
              }
            };
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", ready);
            } else {
              ready();
            }
          })();
        </script>
      </>
    ) : (
      <div id="webtris-container">
        <div id="webtris-wrapper" class="flex justify-center items-center min-h-[80vh] w-full bg-[#010101]">
          <iframe
            id="webtris-frame"
            src="https://theoneand33.github.io/tetr.io-clone/"
            class="w-full max-w-[90vw] h-[80vh] border-0"
            title="Webtris"
            allow="fullscreen"
            allowfullscreen
            loading="eager"
          />
        </div>
        <div class="flex justify-center pt-2">
          <FullscreenButton targetId="webtris-container" />
        </div>
      </div>
    )}
  {seo.guide && (
    <section class="mx-auto max-w-[760px] px-5 pt-6 pb-2">
      <h2 class="mb-2 text-xl font-semibold tracking-tight text-gray-900 dark:text-neutral-100">How to play {seo.title}</h2>
      <p class="text-sm leading-relaxed text-gray-600 dark:text-neutral-400">{seo.guide}</p>
    </section>
  )}
</Layout>

<style>
  /* ponytail: in fullscreen fill the screen, keep game aspect ratio */
  :global(#run3-container:fullscreen),
  :global(#run3-container:-webkit-full-screen) {
    height: 100vh;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  :global(#run3-container:fullscreen #run3-wrapper),
  :global(#run3-container:-webkit-full-screen #run3-wrapper) {
    height: calc(100% - 48px);
  }
  :global(#run3-container:fullscreen #openfl-content),
  :global(#run3-container:-webkit-full-screen #openfl-content) {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(#run3-container:fullscreen canvas),
  :global(#run3-container:-webkit-full-screen canvas) {
    width: min(100vw, 133.33vh);
    height: auto;
  }
  :global(#webtris-container:fullscreen),
  :global(#webtris-container:-webkit-full-screen) {
    width: 100vw;
    min-height: 100vh;
    height: 100vh;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  :global(#webtris-container:fullscreen #webtris-wrapper),
  :global(#webtris-container:-webkit-full-screen #webtris-wrapper) {
    width: 100%;
    min-height: calc(100vh - 48px);
    flex: 1;
  }
  :global(#webtris-container:fullscreen iframe),
  :global(#webtris-container:-webkit-full-screen iframe) {
    width: 100%;
    max-width: none !important;
    height: calc(100vh - 48px);
    flex: 1;
  }
</style>
